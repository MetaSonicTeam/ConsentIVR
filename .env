# ── Core ──────────────────────────────────────────────────────────────
ENVIRONMENT=development                 # development | staging | production
DEBUG=true
SECRET_KEY=change-me-to-a-64-char-random-string
FERNET_KEY=                             # generate with scripts/generate_secret_key.py

# ── Telegram ──────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_OWNER_IDS=123456789,987654321
TELEGRAM_USE_WEBHOOK=false
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://hostbot:hostbot@localhost:5432/hostbot
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=hostbot

# ── Web Admin ─────────────────────────────────────────────────────────
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=change-me
WEB_SESSION_SECRET=change-me-too

# ── Payments ──────────────────────────────────────────────────────────
CRYPTO_PAY_TOKEN=
CRYPTO_PAY_TESTNET=false
TELEGRAM_PAYMENTS_PROVIDER_TOKEN=
STARS_ENABLED=false

# ── Workers ───────────────────────────────────────────────────────────
PROVISIONING_WORKER_CONCURRENCY=5
JOB_MAX_ATTEMPTS=5
JOB_BACKOFF_BASE_SECONDS=30

# ── Observability ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=true
METRICS_ENABLED=true
